# CivicConnect Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.

# Server Configuration
PORT=8000
NODE_ENV=development

# CORS Configuration
# Set to '*' for permissive development (credentials disabled automatically to satisfy browser security specs).
# Or provide a comma-separated allowlist of frontend URLs (credentials will be enabled):
# Example: CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_ORIGIN=*

# Database Configuration
# Set to 'true' to connect to MongoDB before starting the server.
# Set to 'false' to run in standalone mode (useful for testing and development without a running MongoDB).
ENABLE_DB=false
MONGODB_URI=mongodb://127.0.0.1:27017/civicconnect

# Authentication Configuration
# [DEVELOPMENT ONLY] In development, defaults can be used.
# In PRODUCTION, JWT_SECRET is strictly validated: it must be provided, cannot be empty or a placeholder,
# and must be at least 32 characters long for cryptographic security.
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=7d

# OTP Delivery & Verification Configuration
# [DEVELOPMENT ONLY] 'mock' is allowed only in development and testing.
# In PRODUCTION, 'mock' is strictly rejected at startup to prevent unverified citizen logins.
# Production deployments must configure a real SMS provider.
OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Dedicated server-side pepper for HMAC-SHA256 OTP hashing.
# [DEVELOPMENT ONLY] In development, a default fallback is used if omitted.
# In PRODUCTION, OTP_SECRET is strictly validated: it must be provided, cannot be empty or a placeholder,
# and must be at least 32 characters long to prevent brute-force cracking of 6-digit OTPs.
OTP_SECRET=dev_otp_pepper_secret_change_in_production_min_32_chars_long

